/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* Enable the I2C bus for the Seeed XIAO BLE to communicate with the OLED */
&xiao_i2c {
    status = "okay";
};
